# Optional local development settings. The static site needs no secrets.
HOST=127.0.0.1
PORT=8080

# Optional development API protection; leave blank for local unauthenticated use.
ORR_API_KEY=

# Optional journal automation (never commit the real key).
GROQ_API_KEY=
GROQ_MODEL=

# Optional PaperTrail API process. The public static site does not read these.
PAPERTRAIL_HOST=127.0.0.1
PAPERTRAIL_PORT=8788
PAPERTRAIL_ORIGIN=http://127.0.0.1:8080
PAPERTRAIL_DB_PATH=
# Required before binding the API to a non-loopback host; never put this in browser code.
PAPERTRAIL_API_TOKEN=

# Optional browser QA bridge for the read-only Pi telemetry panel.
PI_QA_ENDPOINT=
