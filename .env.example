# Optional local development settings. The static site needs no secrets.
HOST=127.0.0.1
PORT=8080

# Optional development API protection; leave blank for local unauthenticated use.
ORR_API_KEY=

# Optional journal automation (never commit the real key).
GROQ_API_KEY=
GROQ_MODEL=

# Optional browser QA bridge for the read-only Pi telemetry panel.
PI_QA_ENDPOINT=
