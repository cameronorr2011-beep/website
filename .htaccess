# Orr Biologicals â€” orrbiologicals.com
# Canonical host: https://orrbiologicals.com (non-www, HTTPS)

ErrorDocument 404 /404.html

Options -Indexes

# Block dotfiles (.env, .git) and source/tooling files from HTTP access.
# Serves only site content; blocks anything sensitive that ends up in the
# web root (scripts, backups, logs). 2.4 and 2.2 syntax both covered.
<FilesMatch "^\.(?!well-known)|\.(bak|old|orig|save|swp|tmp|py|ps1|yml|yaml|sh|ini|conf|log|sql|md|zip)$|~$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# Source partials, audit artifacts and tooling are not public landing pages.
RewriteRule ^(?:sections|tools|docs)(?:/|$) - [F,L]

# Normalize directory index aliases before the generic .html redirect.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^(?:.*/)?index(?:\.html)?$ /%1 [R=301,L]

# Only normalize a leaf slash when its real HTML document exists.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --- canonical host: force https + non-www ---------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- legacy URL migration (pre-rebuild site) -------------------------------
# Content restored as articles
Redirect 301 /how-to-start-home-spirulina-culture      /blog/how-to-start-home-spirulina-culture
Redirect 301 /harvesting-and-using-fresh-spirulina     /blog/harvesting-and-using-fresh-spirulina
Redirect 301 /zarrouk-medium-and-nutrients             /blog/zarrouk-medium-and-nutrients
Redirect 301 /light-temperature-mixing                 /blog/light-temperature-mixing
Redirect 301 /troubleshooting-contamination-crashes    /blog/troubleshooting-contamination-crashes
Redirect 301 /troubleshooting-ph-and-carbon            /blog/troubleshooting-ph-and-carbon
Redirect 301 /photobioreactor-ai-optimization          /blog/photobioreactor-ai-optimization
Redirect 301 /digital-twins-biological-cultivation     /blog/digital-twins-biological-cultivation
Redirect 301 /spirulina-is-a-cyanobacterium            /blog/spirulina-is-a-cyanobacterium
Redirect 301 /articles                                 /blog/
RedirectMatch 301 ^/insights/?$ /blog/
RedirectMatch 301 ^/control-loop-architecture(?:\.html)?/?$ /blog/control-loop-architecture
Redirect 301 /cultivation                              /blog/
Redirect 301 /reading-your-culture                     /blog/reading-your-culture
Redirect 301 /winter-home-growing-warmth               /blog/winter-home-growing-warmth

# Product / concept equivalents on the rebuilt homepage
# /research/ is now a real topic and methodology hub.
RedirectMatch 301 ^/research$ /research/
Redirect 301 /technology                               /#stack
Redirect 301 /projects                                 /#stack
Redirect 301 /lab                                      /game/
Redirect 301 /algaephyte                               /
# Exact-match only: a plain `Redirect /applications /applications/` prefix-matches
# the trailing-slash path too and loops forever (ERR_TOO_MANY_REDIRECTS).
RedirectMatch 301 ^/applications$ /applications/
RedirectMatch 301 ^/blog$ /blog/
Redirect 301 /what-is-main-plain-language              /blog/what-is-main-plain-language
# Restored control-loop article redirect is defined above (never homepage).
Redirect 301 /alkalinity-as-a-control-variable         /blog/alkalinity-as-a-control-variable
Redirect 301 /dissolved-oxygen-stress-signal           /blog/dissolved-oxygen-stress-signal
Redirect 301 /six-culture-signals-main-senses          /blog/six-culture-signals-main-senses
Redirect 301 /digital-twin-droop-steele-model          /blog/digital-twin-droop-steele-model
Redirect 301 /bounded-autonomy-safe-ai-proposals       /blog/bounded-autonomy-safe-ai-proposals
Redirect 301 /how-main-keeps-culture-safe              /blog/how-main-keeps-culture-safe
Redirect 301 /vision-contamination-detection           /blog/vision-contamination-detection
Redirect 301 /computer-vision-contamination-detection  /blog/vision-contamination-detection
Redirect 301 /edge-ai-biological-systems               /blog/edge-ai-biological-systems
Redirect 301 /federated-learning-network               /blog/federated-learning-network
Redirect 301 /federated-learning-biotech               /#mesh
Redirect 301 /troubleshooting                          /#faults
Redirect 301 /faq                                      /#faq
Redirect 301 /docs                                     /#journal
Redirect 301 /main-dashboard                           /#simulation
Redirect 301 /pbr_simulation                           /#simulation
Redirect 301 /contact                                  /#deploy
Redirect 301 /shop                                     /#deploy
Redirect 301 /about                                    /
Redirect 301 /mycophyte                                /

# Cyanoflow research platform (standalone page)
RedirectMatch 301 ^/CyanoFlow/?$ /cyanoflow
# Legacy species page still appears in search results.
RedirectMatch 301 ^/pavlova-lutheri(?:\.html)?/?$ /applications/species/pavlova

# --- clean URLs: serve /slug -> slug.html (internal), and 301 the reverse --
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# CSS/JS must revalidate: pages ship new markup alongside old stylesheets
# otherwise (7-day caches served a dark-era stylesheet against the cream
# redesign). Versioned query strings on <link>/<script> do the hard busting;
# this is the safety net for pages missed by a version bump.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "max-age=3600, must-revalidate"
</FilesMatch>
</IfModule>
